---
import AvatarComponent from '@/components/ui/avatar'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<article
  class="premium-surface group/blog hover:border-primary/25 overflow-hidden rounded-[1.35rem] transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_28px_80px_rgba(0,0,0,0.3)]"
>
  <Link
    href={`/${entry.collection}/${entry.id}`}
    class="flex h-full flex-col sm:flex-row"
  >
    {
      (entry.data.imageWithoutText || entry.data.imageWithText) && (
        <div class="relative overflow-hidden border-b border-white/[0.08] sm:w-[43%] sm:shrink-0 sm:border-r sm:border-b-0">
          <Image
            src={
              entry.data.imageWithoutText
                ? entry.data.imageWithoutText
                : entry.data.imageWithText!
            }
            alt={entry.data.title}
            width={1200}
            height={630}
            class="aspect-[16/10] size-full object-cover transition-transform duration-700 group-hover/blog:scale-[1.04] sm:aspect-auto"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
        </div>
      )
    }

    <div class="flex grow flex-col p-5 sm:p-7">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="eyebrow">Field notes</p>
          <h3
            class="group-hover/blog:text-primary mt-2 text-xl leading-7 font-semibold tracking-[-0.035em] transition-colors"
          >
            {entry.data.title}
          </h3>
        </div>
        <span
          class="border-foreground/10 bg-foreground/[0.035] group-hover/blog:border-primary/30 group-hover/blog:text-primary flex size-9 shrink-0 items-center justify-center rounded-full border transition-all duration-300 group-hover/blog:rotate-12"
        >
          <Icon name="lucide:arrow-up-right" class="size-4" />
        </span>
      </div>
      <p class="text-muted-foreground mt-3 text-sm leading-7">
        {entry.data.description}
      </p>

      <div
        class="text-muted-foreground mt-5 flex flex-wrap items-center gap-x-2 gap-y-2 font-mono text-[9px]"
      >
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <AvatarComponent
                    client:load
                    src={author.avatar}
                    alt={author.name}
                    fallback={author.name[0]}
                    className="size-4 rounded-full"
                  />
                  <span>{author.name}</span>
                </div>
              ))}
              <span aria-hidden="true" class="text-foreground/20">
                •
              </span>
            </>
          )
        }
        <span>{formattedDate}</span>
        <span aria-hidden="true" class="text-foreground/20">•</span>
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <span aria-hidden="true" class="text-foreground/20">
                •
              </span>
              <span class="flex items-center gap-1">
                <Icon name="lucide:file-text" class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="border-foreground/[0.08] mt-auto flex flex-wrap gap-1.5 border-t pt-5">
            {entry.data.tags.map((tag) => (
              <span class="border-foreground/[0.08] bg-foreground/[0.035] text-foreground/65 rounded-full border px-2.5 py-1 font-mono text-[9px]">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</article>
