---
import { SOCIAL_LINKS } from '@/consts'
import SocialIcons from './SocialIcons.astro'
---

<footer class="px-4 pt-8 pb-6">
  <div
    class="border-foreground/[0.08] mx-auto flex max-w-6xl flex-col items-center justify-center gap-3 border-t pt-6 sm:flex-row sm:justify-between"
  >
    <div class="text-center sm:text-left">
      <span class="text-foreground/80 text-sm font-medium">
        &copy; {new Date().getFullYear()} Prakash Kumar
      </span>
      <p
        class="text-muted-foreground mt-1 font-mono text-[9px] tracking-[0.14em] uppercase"
      >
        Built with intent in Singapore
      </p>
    </div>
    <SocialIcons links={SOCIAL_LINKS} />
  </div>
</footer>
