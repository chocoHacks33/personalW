---
import Link from '@/components/Link.astro'
import { extractDomain, formatMonthYear } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const getEmbedUrl = (url?: string) => {
  if (!url) return null
  try {
    const parsed = new URL(url)
    if (
      parsed.hostname.includes('youtube.com') ||
      parsed.hostname.includes('youtu.be')
    ) {
      const videoId =
        parsed.searchParams.get('v') ||
        (parsed.hostname.includes('youtu.be')
          ? parsed.pathname.replace('/', '')
          : null)

      if (videoId) {
        return `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&playsinline=1&rel=0`
      }
    }
  } catch {
    return null
  }

  return null
}

const demoEmbedUrl = getEmbedUrl(project.data.demoVideo)
const projectCardId = `project-card-${project.id.replace(/[^a-zA-Z0-9-_]/g, '-')}`
---

<article
  id={projectCardId}
  class="project-card premium-surface group/project focus-within:border-primary/30 hover:border-primary/25 relative flex h-full min-h-[28rem] flex-col overflow-hidden rounded-[1.4rem] transition-all duration-500 ease-out hover:-translate-y-1.5 hover:shadow-[0_32px_90px_rgba(0,0,0,0.32)]"
  data-demo-src={demoEmbedUrl ?? undefined}
>
  <Link
    href={project.data.link}
    class="absolute inset-0 z-20 rounded-[1.4rem]"
    external
    aria-label={`Open ${project.data.name}`}
  />

  <div class="relative overflow-hidden border-b border-white/[0.08]">
    {
      project.data.image && (
        <img
          src={project.data.image}
          alt=""
          loading="lazy"
          class="aspect-[16/10] w-full object-cover object-center transition-transform duration-700 ease-out group-hover/project:scale-[1.035]"
        />
      )
    }
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-black/10"
    >
    </div>

    <div class="absolute top-3 right-3 z-10 flex items-center gap-2">
      {
        demoEmbedUrl && (
          <span class="flex items-center gap-1.5 rounded-full border border-white/15 bg-black/45 px-2.5 py-1.5 font-mono text-[9px] tracking-[0.12em] text-white uppercase backdrop-blur-md">
            <Icon name="lucide:play" class="size-3 fill-current" />
            Preview
          </span>
        )
      }
      <span
        class="flex size-8 items-center justify-center rounded-full border border-white/15 bg-black/45 text-white backdrop-blur-md transition-transform duration-300 group-hover/project:rotate-12"
      >
        <Icon name="lucide:arrow-up-right" class="size-3.5" />
      </span>
    </div>

    {
      demoEmbedUrl && (
        <div class="pointer-events-none absolute inset-0 z-10 hidden bg-black opacity-0 transition-opacity duration-500 group-focus-within/project:opacity-100 group-hover/project:opacity-100 lg:block">
          <iframe
            data-src={demoEmbedUrl}
            title={`${project.data.name} demo video`}
            data-demo-iframe
            class="size-full"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="eyebrow">Case study</p>
        <h3
          class="group-hover/project:text-primary mt-2 text-xl font-semibold tracking-[-0.035em] transition-colors duration-300"
        >
          {project.data.name}
        </h3>
      </div>
    </div>

    <p class="text-muted-foreground mt-3 text-sm leading-7">
      {project.data.description}
    </p>

    {
      project.data.tags && (
        <div class="mt-5 flex flex-wrap gap-1.5">
          {project.data.tags.slice(0, 4).map((tag: string) => (
            <span class="border-foreground/[0.08] bg-foreground/[0.035] text-foreground/65 rounded-full border px-2.5 py-1 font-mono text-[9px] tracking-[0.04em]">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div
      class="border-foreground/[0.08] text-muted-foreground mt-auto flex flex-wrap items-center justify-between gap-3 border-t pt-5 font-mono text-[9px]"
    >
      {
        project.data.startDate ? (
          <span class="flex items-center gap-1.5">
            <Icon name="lucide:calendar" class="size-3" />
            {formatMonthYear(project.data.startDate)}
            {project.data.endDate
              ? ` → ${formatMonthYear(project.data.endDate)}`
              : ' → Present'}
          </span>
        ) : (
          <span class="flex items-center gap-1.5">
            <Icon name="lucide:sparkles" class="size-3" />
            Shipped
          </span>
        )
      }
      <span class="flex min-w-0 items-center gap-1.5">
        <Icon name="lucide:external-link" class="size-3 shrink-0" />
        <span class="max-w-44 truncate">{extractDomain(project.data.link)}</span
        >
      </span>
    </div>
  </div>
</article>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll<HTMLElement>(
      '.project-card[data-demo-src]',
    )

    for (const card of cards) {
      const iframe = card.querySelector<HTMLIFrameElement>('[data-demo-iframe]')
      const src = card.dataset.demoSrc

      if (!iframe || !src) continue

      const startPreview = () => {
        if (iframe.src !== src) iframe.src = src
      }

      const stopPreview = () => {
        if (iframe.src) iframe.removeAttribute('src')
      }

      card.addEventListener('mouseenter', startPreview)
      card.addEventListener('mouseleave', stopPreview)
      card.addEventListener('focusin', startPreview)
      card.addEventListener('focusout', stopPreview)
    }
  })
</script>
