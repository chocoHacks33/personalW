---
import Link from '@/components/Link.astro'
import { NAV_LINKS } from '@/consts'
import { cn } from '@/lib/utils'
import { Image } from 'astro:assets'
import logo from '../../public/static/logo.svg'

const pathname = Astro.url.pathname
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href)
---

<header
  transition:persist
  class="border-foreground/[0.09] bg-background/76 mx-auto w-full max-w-6xl rounded-2xl border shadow-[0_16px_50px_rgba(0,0,0,0.26)] backdrop-blur-xl"
>
  <div
    class="flex items-center justify-between gap-2 px-2.5 py-2 sm:gap-4 sm:px-3"
  >
    <Link
      href="/"
      class="group/brand flex shrink-0 items-center gap-2.5 rounded-xl pr-2"
      aria-label="Prakash Kumar — Home"
    >
      <span
        class="border-foreground/10 bg-foreground/[0.04] group-hover/brand:border-primary/30 group-hover/brand:bg-primary/10 flex size-8 items-center justify-center rounded-[0.65rem] border transition-all duration-300 sm:size-9"
      >
        <Image src={logo} alt="" class="size-4 sm:size-[1.1rem]" />
      </span>
      <span class="hidden sm:block">
        <span class="block text-[13px] leading-none font-semibold"
          >Prakash Kumar</span
        >
        <span
          class="text-muted-foreground mt-1 block font-mono text-[8px] tracking-[0.2em] uppercase"
          >Builder · Engineer</span
        >
      </span>
    </Link>
    <div class="flex min-w-0 items-center">
      <nav
        class="bg-foreground/[0.035] flex items-center gap-0.5 rounded-xl border border-white/[0.04] p-1 font-mono text-[10px] sm:text-[11px]"
        aria-label="Primary navigation"
      >
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class={cn(
                'text-muted-foreground hover:text-foreground inline-flex rounded-lg px-2 py-2 capitalize transition-all duration-300 sm:px-3',
                item.label === 'Home' && 'hidden md:inline-flex',
                isActive(item.href) &&
                  'bg-foreground/[0.08] text-foreground shadow-[0_1px_0_rgba(255,255,255,0.06)_inset]',
              )}
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
    </div>
  </div>
</header>
