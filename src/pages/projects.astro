---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const projects = await getAllProjects()
---

<Layout>
  <PageHead
    slot="head"
    title="Projects"
    description="Products, AI systems, infrastructure, and hackathon projects built by Prakash Kumar."
  />
  <div class="mx-auto w-full max-w-6xl">
    <Breadcrumbs items={[{ label: 'Projects', icon: 'lucide:briefcase' }]} />

    <section
      class="page-hero mt-6 px-5 py-8 sm:px-8 sm:py-10 lg:px-11 lg:py-12"
    >
      <div
        class="relative z-10 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
      >
        <div class="max-w-3xl">
          <p class="eyebrow">Selected builds · Product to production</p>
          <h1
            class="mt-4 max-w-3xl text-3xl leading-tight font-semibold tracking-[-0.045em] sm:text-5xl"
          >
            Experiments with enough conviction to become real products.
          </h1>
          <p
            class="text-muted-foreground mt-5 max-w-2xl text-sm leading-7 sm:text-base sm:leading-8"
          >
            AI agents, developer infrastructure, computer vision, spatial
            computing, and fast-moving hackathon systems—designed, built, and
            tested in the real world.
          </p>
        </div>

        <div class="grid shrink-0 grid-cols-2 gap-2 font-mono">
          <div
            class="border-foreground/10 bg-foreground/[0.035] min-w-28 rounded-2xl border p-4"
          >
            <span class="text-primary text-2xl font-semibold"
              >{projects.length}</span
            >
            <span
              class="text-muted-foreground mt-1 block text-[9px] tracking-[0.16em] uppercase"
            >
              Shipped projects
            </span>
          </div>
          <div
            class="border-foreground/10 bg-foreground/[0.035] min-w-28 rounded-2xl border p-4"
          >
            <span class="text-primary flex h-8 items-center">
              <Icon name="lucide:zap" class="size-5" />
            </span>
            <span
              class="text-muted-foreground mt-1 block text-[9px] tracking-[0.16em] uppercase"
            >
              Built to move
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12 sm:mt-16" aria-labelledby="projects-heading">
      <div
        class="flex items-end justify-between gap-5 border-b border-white/[0.08] pb-5"
      >
        <div>
          <p class="eyebrow">Project archive</p>
          <h2
            id="projects-heading"
            class="mt-2 text-2xl font-semibold tracking-[-0.035em]"
          >
            Things I&rsquo;ve shipped
          </h2>
        </div>
        <p class="text-muted-foreground hidden font-mono text-[10px] sm:block">
          Hover video projects for a live preview.
        </p>
      </div>

      <ul class="mt-7 grid gap-5 lg:grid-cols-2">
        {
          projects.map((project) => (
            <li class="h-full">
              <ProjectCard project={project} />
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
