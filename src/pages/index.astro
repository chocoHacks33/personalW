---
import TechStackCard from '@/components/bento/TechStackCard.tsx'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const latestPost = await getAllPosts().then((posts) => posts.at(0))
const photoSlides = [
  '/static/bento/photos/6199387384990863519.jpg',
  '/static/bento/photos/6199387384990863963.jpg',
  '/static/bento/photos/6199387384990863964.jpg',
  '/static/bento/photos/6199387384990863965.jpg',
  '/static/bento/photos/6199387384990863966.jpg',
  '/static/bento/photos/6199387384990863967.jpg',
  '/static/bento/photos/6199387384990863968.jpg',
  '/static/bento/photos/6199387384990863969.jpg',
  '/static/bento/photos/6199387384990863970.jpg',
  '/static/bento/photos/6199387384990863971.jpg',
]
---

<Layout class="px-2">
  <PageHead slot="head" title="Home" />
  <section
    class={cn(
      'home-bento mx-auto grid min-w-xs sm:has-[[data-trigger]:hover]:*:first:[&_[data-overlay]]:opacity-0',
      'max-w-sm grid-cols-1 [grid-template-areas:"a""b""e""d""j""i""k""l"]',
      'sm:max-w-2xl sm:grid-cols-2 sm:[grid-template-areas:"a_a""b_d""e_e""j_i""h_c""h_l""k_l"]',
      'lg:max-w-5xl lg:grid-cols-3 lg:[grid-template-areas:"a_a_b""d_e_e""h_j_i""h_c_k""h_l_l"]',
      'xl:max-w-7xl xl:grid-cols-4 xl:[grid-template-areas:"a_a_b_c""d_e_e_c""h_j_i_k""h_l_l_l"]',
    )}
  >
    <div class="aspect-[3/4] p-2 [grid-area:a] sm:aspect-[2/1] xl:aspect-[2/1]">
      <div class="bg-muted size-full border">
        <div
          class="size-full bg-[url('/static/bento/about-background-square.png')] bg-cover bg-center bg-no-repeat sm:bg-[url('/static/bento/about-background.png')]"
        >
          <div
            data-overlay
            class="size-full bg-[url('/static/bento/about-foreground-square.png')] bg-cover bg-center bg-no-repeat transition-opacity duration-200 sm:bg-[url('/static/bento/about-foreground.png')]"
          >
            <div class="flex p-4">
              <div class="hidden w-1/3 sm:block"></div>
              <div class="space-y-4 sm:w-2/3">
                <p
                  class="text-foreground/80 bg-background block border p-3 text-sm text-pretty"
                >
                  Hey, I&rsquo;m Prakash! I&rsquo;m a Computer Science student
                  at NUS, builder, and product engineer based in Singapore. I
                  like building fast, stress-testing ideas in the real world,
                  and shipping systems that actually get used.
                </p>
                <p
                  class="text-foreground/80 bg-background block border p-3 text-sm text-pretty"
                >
                  I co-founded The Collective, a venture builder and a community
                  connecting ambitious builders across universities. I work
                  closely with early-stage founders and through it shape my own
                  ventures, including adMorph.ai. You can read more about me <Link
                    href="/about"
                    class="text-foreground decoration-muted-foreground hover:decoration-foreground font-medium break-words underline underline-offset-[3px] transition-colors"
                    >here</Link
                  >!
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="aspect-square p-2 [grid-area:b]">
      <div data-trigger class="bg-muted size-full border">
        <div
          class="size-full bg-[url('/static/bento/details-background.png')] bg-cover bg-center bg-no-repeat"
        >
          <div
            class="relative size-full bg-[url('/static/bento/details-foreground.png')] bg-cover bg-center bg-no-repeat transition-opacity duration-200 sm:opacity-0 sm:hover:opacity-100"
          >
            <div
              class="absolute inset-0 flex flex-col justify-center gap-3 px-4 py-5"
            >
              <p
                class="text-foreground/80 bg-background mr-14 border p-3 text-xs text-pretty"
              >
                Click <Link
                  href="/work"
                  class="text-foreground decoration-muted-foreground hover:decoration-foreground font-medium break-words underline underline-offset-[3px] transition-colors"
                  >here</Link
                > for my work experience and to learn more about my ventures!
              </p>
              <p
                class="text-foreground/80 bg-background mr-24 border p-3 text-xs text-pretty"
              >
                Click <Link
                  href="/projects"
                  class="text-foreground decoration-muted-foreground hover:decoration-foreground font-medium break-words underline underline-offset-[3px] transition-colors"
                  >here</Link
                > to find out more about the projects I have done across hackathons!
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="hidden p-2 [grid-area:c] sm:block sm:aspect-[1/2] lg:aspect-square xl:aspect-[1/2]"
    >
      <div class="bg-muted size-full border">
        <div
          class="size-full bg-[url('/static/bento/image-1.png')] bg-cover bg-center bg-no-repeat"
        >
        </div>
      </div>
    </div>
    <div class="aspect-auto p-2 [grid-area:d] sm:aspect-square">
      <div class="bg-muted size-full border">
        <div
          data-photo-carousel
          data-slides={JSON.stringify(photoSlides)}
          class="group/photo relative size-full overflow-hidden"
        >
          <div
            data-photo-frame
            class="size-full bg-cover bg-center bg-no-repeat brightness-[0.78] contrast-[0.95] grayscale saturate-[0.7] sepia-[0.65] transition-[background-image,transform,filter] duration-300"
            style={`background-image: url('${photoSlides[0] ?? '/static/bento/avatar.jpg'}')`}
          >
          </div>
          <div
            class="from-background/25 pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b to-transparent"
          >
          </div>
          <div
            class="from-background/45 pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t to-transparent"
          >
          </div>
          <button
            type="button"
            data-photo-next
            class="bg-border/50 text-primary ring-ring absolute right-3 bottom-3 flex size-12 items-center justify-center rounded-full transition-[box-shadow,transform,background-color] duration-300 hover:-translate-y-0.5 hover:ring-2 focus-visible:ring-2"
            aria-label="Show next photo"
          >
            <Icon name="lucide:move-right" size={18} />
          </button>
        </div>
      </div>
    </div>
    <div class="aspect-[6/5] p-2 [grid-area:e] sm:aspect-[2/1]">
      <div data-trigger class="bg-muted size-full border">
        <div
          class="group/blog relative size-full bg-[url('/static/bento/blog-background-square.png')] bg-cover bg-center bg-no-repeat sm:bg-[url('/static/bento/blog-background.png')]"
        >
          <div
            class="absolute size-full bg-[url('/static/bento/blog-foreground-square.png')] bg-cover bg-center bg-no-repeat transition-opacity duration-200 sm:bg-[url('/static/bento/blog-foreground.png')] sm:opacity-0 sm:group-hover/blog:opacity-100"
          >
            <p
              class="text-foreground/80 bg-background absolute bottom-4 left-16 border p-2 text-xs text-pretty sm:top-[42.5%] sm:right-4 sm:bottom-[inherit] sm:left-[inherit] sm:-translate-y-1/2"
            >
              Read my latest<br /> blog post!
            </p>
          </div>
          <div class="p-3 sm:size-full sm:p-6">
            {
              latestPost && (
                <Link href={`/blog/${latestPost.id}`} class="flex h-full">
                  <img
                    src={latestPost.data.imageWithText?.src ?? '#'}
                    alt={`Featured image for the latest post: ${latestPost.data.title}`}
                    class="h-full border"
                  />
                </Link>
              )
            }
          </div>
          {
            latestPost && (
              <Link
                href={`/blog/${latestPost.id}`}
                title={`Read latest blog post: ${latestPost.data.title}`}
                aria-label={`Read latest blog post: ${latestPost.data.title}`}
                class="bg-border/50 text-primary ring-ring group/blog-link absolute end-0 bottom-0 m-3 rounded-full p-3 transition-[box-shadow] duration-300 hover:ring-2 focus-visible:ring-2"
              >
                <Icon
                  name="lucide:move-up-right"
                  class="transition-transform duration-300 group-hover/blog-link:rotate-12"
                  size={16}
                />
              </Link>
            )
          }
        </div>
      </div>
    </div>
    <div class="hidden p-2 [grid-area:h] sm:block sm:aspect-[1/2]">
      <div class="bg-muted size-full border">
        <div
          class="size-full bg-[url('/static/bento/image-2.png')] bg-cover bg-center bg-no-repeat"
        >
        </div>
      </div>
    </div>
    <div class="aspect-square p-2 [grid-area:i]">
      <div class="bg-muted size-full border">
        <div
          class="group/github relative flex size-full items-center justify-center bg-[url('/static/bento/github-background.png')] bg-cover bg-center bg-no-repeat"
        >
          <div
            class="size-full bg-[url('/static/bento/github-foreground.png')] bg-cover bg-center bg-no-repeat transition-opacity duration-200 sm:opacity-0 sm:group-hover/github:opacity-100"
            aria-hidden="true"
          >
          </div>
          <Icon
            name="mdi:github"
            class="text-primary absolute size-1/2 sm:size-24"
            aria-hidden="true"
          />
          <Link
            href={SOCIAL_LINKS.find((link) => link.label === 'GitHub')?.href ||
              '#'}
            title="Visit my GitHub profile"
            aria-label="Visit my GitHub profile"
            external
            class="bg-border/50 text-primary ring-ring group/github-link absolute end-0 bottom-0 m-3 rounded-full p-3 transition-[box-shadow] duration-300 hover:ring-2 focus-visible:ring-2"
          >
            <Icon
              name="lucide:move-up-right"
              class="transition-transform duration-300 group-hover/github-link:rotate-12"
              size={16}
            />
          </Link>
        </div>
      </div>
    </div>
    <div class="aspect-square p-2 [grid-area:j]">
      <div class="bg-muted size-full border">
        <TechStackCard />
      </div>
    </div>
    <div class="aspect-square p-2 [grid-area:k]">
      <div data-trigger class="bg-muted size-full border">
        <div
          class="group/linkedin relative flex size-full items-center justify-center bg-[url('/static/bento/twitter-background.png')] bg-cover bg-center bg-no-repeat"
        >
          <div
            class="size-full bg-[url('/static/bento/twitter-foreground.png')] bg-cover bg-center bg-no-repeat transition-opacity duration-200 sm:opacity-0 sm:group-hover/linkedin:opacity-100"
            aria-hidden="true"
          >
            <p
              class="text-foreground/80 bg-background absolute bottom-4 left-4 hidden border p-2 text-xs text-pretty sm:block"
            >
              Connect with me<br />on LinkedIn!
            </p>
          </div>
          <Icon
            name="mdi:linkedin"
            class="text-primary absolute size-1/2 sm:size-24"
            aria-hidden="true"
          />
          <Link
            href={SOCIAL_LINKS.find((link) => link.label === 'LinkedIn')
              ?.href || '#'}
            title="Visit my LinkedIn profile"
            aria-label="Visit my LinkedIn profile"
            external
            class="bg-border/50 text-primary ring-ring group/linkedin-link absolute end-0 bottom-0 m-3 rounded-full p-3 transition-[box-shadow] duration-300 hover:ring-2 focus-visible:ring-2"
          >
            <Icon
              name="lucide:move-up-right"
              class="transition-transform duration-300 group-hover/linkedin-link:rotate-12"
              size={16}
            />
          </Link>
        </div>
      </div>
    </div>
    <div class="p-2 [grid-area:l]">
      <div class="bg-muted/20 relative overflow-hidden border">
        <div
          class="group/resume relative flex aspect-[4/1] min-h-36 w-full items-center justify-between gap-6 overflow-hidden px-6 py-5"
        >
          <div
            class="absolute inset-0 bg-[url('/static/bento/image-2.png')] bg-cover bg-center bg-no-repeat opacity-20"
            aria-hidden="true"
          >
          </div>
          <div
            class="from-background via-background/94 to-background/80 absolute inset-0 bg-gradient-to-r"
          >
          </div>

          <div class="relative z-10 max-w-xl">
            <p
              class="text-muted-foreground text-[11px] tracking-[0.28em] uppercase"
            >
              Resume
            </p>
            <h3 class="mt-2 text-xl font-medium">Download my resume</h3>
            <p class="text-foreground/72 mt-3 text-sm leading-7">
              A concise view of my internships, startups, technical work, and
              experience across product and engineering.
            </p>
          </div>

          <div class="relative z-10 shrink-0">
            <a
              href="/static/resume/Prakash.pdf"
              download="Prakash Resume.pdf"
              class="bg-border/50 text-primary ring-ring inline-flex items-center gap-2 rounded-full border px-4 py-3 text-sm transition-[box-shadow,transform,background-color] duration-300 hover:-translate-y-0.5 hover:ring-2 focus-visible:ring-2"
            >
              <Icon name="lucide:download" size={16} />
              <span>Download PDF</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll('[data-photo-carousel]').forEach((carousel) => {
      const frame = carousel.querySelector('[data-photo-frame]')
      const nextButton = carousel.querySelector('[data-photo-next]')
      const slides = JSON.parse(carousel.dataset.slides || '[]')
      let index = 0

      if (!frame || !nextButton || slides.length === 0) return

      const render = () => {
        frame.style.backgroundImage = `url('${slides[index]}')`
      }

      nextButton.addEventListener('click', () => {
        index = (index + 1) % slides.length
        render()
      })
    })
  </script>
</Layout>
