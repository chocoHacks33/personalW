---

<Layout>
  <PageHead
    slot="head"
    title="About"
    description="About Prakash Kumar—NUS computer science student, product engineer, founder, and relentless hackathon builder in Singapore."
  />
  <div class="mx-auto w-full max-w-6xl">
    <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

    <section
      class="page-hero mt-6 px-5 py-8 sm:px-8 sm:py-10 lg:px-11 lg:py-12"
    >
      <div
        class="relative z-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-end"
      >
        <div class="max-w-3xl">
          <p class="eyebrow">About me · Singapore</p>
          <h1
            class="mt-4 text-3xl leading-tight font-semibold tracking-[-0.045em] sm:text-5xl"
          >
            Curious by default.<br />Builder by instinct.
          </h1>
          <p
            class="text-muted-foreground mt-5 max-w-2xl text-sm leading-7 sm:text-base sm:leading-8"
          >
            I&rsquo;m Prakash, a Computer Science student at NUS who likes
            turning ambitious ideas into products, communities, and systems that
            hold up outside the demo.
          </p>
        </div>

        <div
          class="border-foreground/10 bg-foreground/[0.035] rounded-2xl border p-4 backdrop-blur-sm"
        >
          <p class="eyebrow">Current focus</p>
          <p class="mt-3 text-sm leading-7">
            Applied AI, product engineering, startup execution, and building at
            unreasonable speed.
          </p>
        </div>
      </div>
    </section>

    <section
      class="mt-12 grid gap-5 sm:mt-16 lg:grid-cols-[17rem_minmax(0,1fr)] lg:items-start"
    >
      <aside
        class="premium-surface overflow-hidden rounded-[1.35rem] lg:sticky lg:top-28"
      >
        <img
          src="/static/bento/avatar.jpg"
          alt="Prakash Kumar"
          class="aspect-square w-full object-cover object-center grayscale sepia-[0.25]"
        />
        <div class="border-t border-white/[0.08] p-5">
          <p class="text-lg font-semibold tracking-[-0.03em]">Prakash Kumar</p>
          <p class="text-muted-foreground mt-1 text-sm">
            Product engineer & founder
          </p>
          <dl
            class="mt-5 space-y-3 border-t border-white/[0.08] pt-5 font-mono text-[9px]"
          >
            <div class="flex items-center justify-between gap-3">
              <dt class="text-muted-foreground uppercase">Based in</dt>
              <dd>Singapore</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-muted-foreground uppercase">Studying</dt>
              <dd>NUS Computing</dd>
            </div>
            <div class="flex items-center justify-between gap-3">
              <dt class="text-muted-foreground uppercase">Mode</dt>
              <dd class="text-primary">Always shipping</dd>
            </div>
          </dl>
        </div>
      </aside>

      <article
        class="prose premium-surface max-w-none rounded-[1.35rem] px-5 py-6 sm:px-8 sm:py-8"
      >
        <Content />
      </article>
    </section>

    <!-- <div class="mx-auto w-full max-w-5xl">
      {
        sections.map((section) => (
          <div class="flex w-full flex-col gap-4 border p-4">
            <div class="mx-auto w-full max-w-[calc(var(--container-3xl)-2rem)]">
              <h3 class="m-0 mb-2">
                <span class="text-primary font-medium">Q.</span>{' '}
                {section.question}
              </h3>
              <p class="text-muted-foreground m-0 text-[13px] leading-5">
                <span class="text-primary font-medium">A.</span>
                <Fragment set:html={section.answer} />
              </p>
            </div>
            <section.ContentComponent />
          </div>
        ))
      }
    </div> -->
  </div>
</Layout>
