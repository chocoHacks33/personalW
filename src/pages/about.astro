import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Content } from '../content/about.mdx'

// const sections = [
//   {
//     question: 'What type of music do you listen to?',
//     answer: `Music is a really important part of my life! I play and arrange classical guitar music, and I frequently attend concerts. Here is my <a href="https://last.fm/user/enscribe" target="_blank" rel="noopener noreferrer" class="text-foreground decoration-muted-foreground hover:decoration-foreground font-medium break-words underline underline-offset-[3px] transition-colors">Last.fm</a> profile, and here are my favorite LPs/EPs/cherry-picked tracks of all time:`,
//     ContentComponent: Albums,
