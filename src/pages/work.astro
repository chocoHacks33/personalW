---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'

const entries = [
  {
    id: 'ifixai',
    type: 'Internship',
    period: '2026',
    dateRange: 'June 2026 - Present',
    title: 'AI Software Engineer Intern',
    organization: 'iFixAi',
    location: 'London',
    summary:
      'Building evaluation and governance infrastructure for tool-using AI agents, with an emphasis on independent scoring, enforceable safeguards, and measurable remediation.',
    highlights: [
      'Built a Python evaluation pipeline with 13 governance checks, two independent LLM evaluators, and web-based scorecards.',
      'Implemented six safeguards: role-based access control, policy enforcement, audit logging, rate limiting, schema validation, and resilient API handling.',
      'Turned failed evaluations into stronger fixtures and policies through a remediation loop, improving governance scores by 35% on average.',
    ],
    monogram: 'IF',
    logo: '/static/logos/ifixai.svg',
  },
  {
    id: 'elevenlabs',
    type: 'Community',
    period: '2026',
    dateRange: '2026 - Present',
    title: 'Community Builder',
    organization: 'ElevenLabs',
    location: 'Singapore',
    summary:
      'Supporting the Singapore builder community around voice and conversational AI by connecting developers, sharing practical work, and helping ideas move from experiments to useful products.',
    highlights: [],
    monogram: '11',
    logo: '/static/logos/elevenlabs.svg',
  },
  {
    id: 'gmi-cloud',
    type: 'Developer Program',
    period: '2026',
    dateRange: '2026 - Present',
    title: 'Clouder (Developer)',
    organization: 'GMI Cloud',
    location: 'Singapore',
    summary:
      'Selected as a Clouder to build with GMI Cloud’s AI-native GPU infrastructure and contribute to technical community initiatives.',
    highlights: [],
    monogram: 'GMI',
    logo: '/static/logos/gmi-cloud.svg',
  },
  {
    id: 'the-collective',
    type: 'Startup',
    period: '2025',
    dateRange: 'September 2025 - Present',
    title: 'Co-Founder',
    organization: 'The Collective',
    location: 'Singapore',
    summary:
      'Co-founded a venture studio that helps student founders grow their startups, build peer networks, and access corporate opportunities.',
    highlights: [
      'Built a community spanning 70 startups and 150 student founders.',
      'Raised more than USD $20,000 across seven founder-focused events.',
      'Led a 20-person team and served as product owner across three development sprints.',
    ],
    monogram: 'TC',
    logo: '/static/logos/collective.png',
  },
  {
    id: 'edgemaker-ai',
    type: 'Internship',
    period: '2025',
    dateRange: 'March 2025 - August 2025',
    title: 'AI Software Engineer Intern',
    organization: 'Edgemaker.AI',
    location: 'Singapore',
    summary:
      'Built AI product and backend systems at Edgemaker.AI, spanning analytics, LLM workflows, and ecosystem-facing startup initiatives.',
    highlights: [
      "Built an AI analytics dashboard using React.js, Express.js and Python which analyzes Instagram influencers' data with 86% accuracy to score their trustworthiness and commenter activity.",
      'Built and deployed a Retrieval-Augmented Generation chatbot at four client sites so moderators could query group-chat histories.',
      'Shipped a floating React support widget across three websites.',
      'Secured USD $7,000 in sponsorship from three partners and organized NeuroSpark, a 250-participant entrepreneurship event featuring EdgeMaker solutions.',
    ],
    monogram: 'EA',
    logo: '/static/logos/edgemaker.png',
  },
  {
    id: 'invigilo-ai',
    type: 'Internship',
    period: '2023',
    dateRange: 'January 2023 - April 2023',
    title: 'SW Engineer Intern',
    organization: 'Invigilo AI',
    location: 'Singapore',
    summary:
      'Built internal tooling, alerting, and data systems at Invigilo Safety AI to support production AI deployments and operational workflows.',
    highlights: [
      'Built Telegram bot that alerted DevOps team about uptime for 30 on-premise AI deployments, enhancing monitoring efficiency.',
      'Built CVData, a Git-like computer-vision dataset platform used by a 15-person MLOps team for more than three years.',
      'Developed data collection pipelines to filter and collect camera footage from 6 sites in Singapore.',
      'Developed a Python rules engine for customizable business logic across 10 AI deployments.',
      'Represented Invigilo at a build-tech conference and generated more than 30 sales leads.',
    ],
    monogram: 'IS',
    logo: '/static/logos/invigilo.png',
  },
  {
    id: 'science-centre',
    type: 'Internship',
    period: '2021',
    dateRange: 'December 2021 - January 2022',
    title: 'Research Intern',
    organization: 'Singapore Science Center',
    location: 'Singapore',
    summary:
      'Worked on experimental and research-oriented prototyping, testing, and reporting as part of a short research internship.',
    highlights: [
      'Developed ultrasonic transmitter and receiver in Hex',
      'Generated test data of 100 combinations of environments and configurations',
      'Authored report with findings and presented to panel of 20 mentors',
    ],
    monogram: 'SC',
    logo: '/static/logos/sci.png',
  },
]
---

<Layout>
  <PageHead
    slot="head"
    title="Work"
    description="Prakash Kumar's experience across AI engineering, startups, developer communities, and applied research."
  />

  <div class="mx-auto w-full max-w-6xl">
    <Breadcrumbs items={[{ label: 'Work', icon: 'lucide:briefcase' }]} />

    <section
      class="page-hero mt-6 px-5 py-8 sm:px-8 sm:py-10 lg:px-11 lg:py-12"
    >
      <div class="relative z-10 max-w-3xl">
        <p class="eyebrow">Selected experience · 2021—Now</p>
        <h1
          class="mt-4 max-w-2xl text-3xl leading-tight font-semibold tracking-[-0.045em] sm:text-5xl"
        >
          Building useful AI systems—and the communities around them.
        </h1>
        <p
          class="text-muted-foreground mt-5 max-w-2xl text-sm leading-7 sm:text-base sm:leading-8"
        >
          A chronological view of the teams, ventures, and technical
          environments that have shaped how I move from an ambitious idea to
          something people can actually use.
        </p>

        <div
          class="mt-7 flex flex-wrap gap-2 font-mono text-[10px] tracking-[0.12em] uppercase"
        >
          <span
            class="border-foreground/10 bg-foreground/[0.035] rounded-full border px-3 py-1.5"
          >
            AI engineering
          </span>
          <span
            class="border-foreground/10 bg-foreground/[0.035] rounded-full border px-3 py-1.5"
          >
            Product
          </span>
          <span
            class="border-foreground/10 bg-foreground/[0.035] rounded-full border px-3 py-1.5"
          >
            Community
          </span>
        </div>
      </div>
    </section>

    <section class="mt-12 sm:mt-16" aria-labelledby="experience-heading">
      <div
        class="flex items-end justify-between gap-6 border-b border-white/[0.08] pb-5"
      >
        <div>
          <p class="eyebrow">Timeline</p>
          <h2
            id="experience-heading"
            class="mt-2 text-2xl font-semibold tracking-[-0.035em]"
          >
            Work, communities & ventures
          </h2>
        </div>
        <p
          class="text-muted-foreground hidden max-w-xs text-right font-mono text-[10px] leading-5 sm:block"
        >
          Seven chapters across engineering, research, and venture building.
        </p>
      </div>

      <div class="relative mt-7 pl-5 sm:pl-8">
        <div
          aria-hidden="true"
          class="from-primary/55 via-border to-border absolute top-4 bottom-4 left-[0.45rem] w-px bg-gradient-to-b sm:left-[0.7rem]"
        >
        </div>

        <ol class="space-y-5">
          {
            entries.map((entry) => (
              <li class="group/timeline relative">
                <div
                  aria-hidden="true"
                  class="border-primary/35 bg-background group-hover/timeline:border-primary absolute top-8 left-0 z-10 flex size-4 items-center justify-center rounded-full border shadow-[0_0_0_5px_var(--background)] transition-all duration-300 sm:left-[0.25rem]"
                >
                  <div class="bg-primary/70 group-hover/timeline:bg-primary size-1.5 rounded-full transition-colors duration-300" />
                </div>

                <article
                  id={entry.id}
                  class="premium-surface group-hover/timeline:border-primary/25 ml-6 scroll-mt-28 rounded-[1.35rem] transition-all duration-500 group-hover/timeline:-translate-y-1 group-hover/timeline:shadow-[0_30px_85px_rgba(0,0,0,0.3)] sm:ml-10"
                >
                  <div class="grid gap-0 lg:grid-cols-[10rem_minmax(0,1fr)]">
                    <div class="border-foreground/[0.08] flex items-start justify-between gap-3 border-b px-5 py-5 lg:flex-col lg:justify-start lg:border-r lg:border-b-0 lg:px-6 lg:py-7">
                      <div>
                        <p class="text-primary font-mono text-[9px] font-semibold tracking-[0.22em] uppercase">
                          {entry.type}
                        </p>
                        <p class="mt-2 text-xl font-semibold tracking-[-0.03em]">
                          {entry.period}
                        </p>
                      </div>
                      <span class="text-muted-foreground font-mono text-[9px] tracking-[0.15em] uppercase lg:mt-auto">
                        Chapter · {entry.period}
                      </span>
                    </div>

                    <div class="p-5 sm:p-6 lg:p-7">
                      <div class="flex flex-col items-start gap-4 sm:flex-row sm:gap-5">
                        {entry.logo ? (
                          <div class="border-foreground/10 bg-foreground/[0.035] group-hover/timeline:border-primary/25 group-hover/timeline:bg-primary/[0.06] flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl border p-2.5 shadow-[0_1px_0_rgba(255,255,255,0.05)_inset] transition-all duration-500 sm:size-16">
                            <img
                              src={entry.logo}
                              alt={`${entry.organization} logo`}
                              loading="lazy"
                              class="max-h-full max-w-full object-contain"
                            />
                          </div>
                        ) : (
                          <div class="border-foreground/10 bg-foreground/[0.035] text-primary flex size-14 shrink-0 items-center justify-center rounded-2xl border font-mono text-xs font-semibold sm:size-16">
                            {entry.monogram}
                          </div>
                        )}

                        <div class="min-w-0 flex-1">
                          <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
                            <div>
                              <h3 class="group-hover/timeline:text-primary text-xl font-semibold tracking-[-0.035em] transition-colors duration-300">
                                {entry.title}
                              </h3>
                              <p class="text-foreground/75 mt-1 text-sm font-medium">
                                {entry.organization}
                              </p>
                            </div>

                            <div class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1.5 font-mono text-[10px]">
                              <span class="flex items-center gap-1.5">
                                <Icon name="lucide:map-pin" class="size-3" />
                                {entry.location}
                              </span>
                              <span class="flex items-center gap-1.5">
                                <Icon
                                  name="lucide:calendar-range"
                                  class="size-3"
                                />
                                {entry.dateRange}
                              </span>
                            </div>
                          </div>

                          <p class="text-muted-foreground mt-5 text-sm leading-7 sm:text-[15px]">
                            {entry.organization === 'The Collective' ? (
                              <>
                                Co-founded The Collective, a venture studio that
                                helps student founders grow their startups,
                                build peer networks, and access corporate
                                opportunities. Visit the{' '}
                                <a
                                  href="https://www.thecollectivefounders.com/"
                                  target="_blank"
                                  rel="noreferrer noopener"
                                  class="text-foreground decoration-primary/50 hover:text-primary underline underline-offset-4 transition-colors"
                                >
                                  community website.
                                </a>
                              </>
                            ) : (
                              entry.summary
                            )}
                          </p>

                          {entry.highlights.length > 0 && (
                            <ul class="border-foreground/[0.08] mt-5 grid gap-3 border-t pt-5 sm:grid-cols-2">
                              {entry.highlights.map((highlight) => (
                                <li class="text-foreground/72 flex items-start gap-2.5 text-xs leading-6">
                                  <Icon
                                    name="lucide:arrow-up-right"
                                    class="text-primary mt-1 size-3 shrink-0"
                                  />
                                  <span>{highlight}</span>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</Layout>
