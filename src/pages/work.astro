---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'

const entries = [
  {
    type: 'Startup',
    period: '2026',
    dateRange: 'October 2025 - Present',
    title: 'Co-Founder',
    organization: 'The Collective',
    location: 'Singapore',
    summary:
      'Co-Founded The Collective, a Venture Studio that accelerates student startup founders growth and brings corporate deals to them. Checkout our website here: https://www.thecollectivefounders.com/',
    highlights: [],
    monogram: 'TC',
    logo: '/static/logos/collective.png',
  },
  {
    type: 'Internship',
    period: '2025',
    dateRange: 'March 2025 - August 2025',
    title: 'SW Engineer Intern',
    organization: 'Edgemaker.AI',
    location: 'Singapore',
    summary:
      'Built AI product and backend systems at Edgemaker.AI, spanning analytics, LLM workflows, and ecosystem-facing startup initiatives.',
    highlights: [
      "Built an AI analytics dashboard using React.js, Express.js and Python which analyzes Instagram influencers' data with 86% accuracy to score their trustworthiness and commenter activity.",
      'Built a Retrieval Augmented Generation (RAG) based chatbot for chat group moderators to query chat histories.',
      'Secured sponsorship of USD $6000 from 3 partners and organized NeuroSpark, a 250-participant entrepreneurship event, featuring EdgeMaker solutions.',
    ],
    monogram: 'EA',
    logo: '/static/logos/edgemaker.png',
  },
  {
    type: 'Internship',
    period: '2023',
    dateRange: 'January 2023 - April 2023',
    title: 'SW Engineer Intern',
    organization: 'Invigilo Safety AI',
    location: 'Singapore',
    summary:
      'Built internal tooling, alerting, and data systems at Invigilo Safety AI to support production AI deployments and operational workflows.',
    highlights: [
      'Built Telegram bot that alerted DevOps team about uptime for 30 on-premise AI deployments, enhancing monitoring efficiency.',
      'Developed data collection pipelines to filter and collect camera footage from 6 sites in Singapore.',
      'Developed a Python library for a rule-based engine, facilitating customizable business logic solutions in AI applications.',
      'Represented Invigilo at a build tech conference, gathering 50 sales leads.',
    ],
    monogram: 'IS',
    logo: '/static/logos/invigilo.png',
  },
  {
    type: 'Internship',
    period: '2021',
    dateRange: 'December 2021 - January 2022',
    title: 'Research Intern',
    organization: 'Singapore Science Center',
    location: 'Singapore',
    summary:
      'Worked on experimental and research-oriented prototyping, testing, and reporting as part of a short research internship.',
    highlights: [
      'Developed ultrasonic transmitter and receiver in Hex',
      'Generated test data of 100 combinations of environments and configurations',
      'Authored report with findings and presented to panel of 20 mentors',
    ],
    monogram: 'SC',
    logo: '/static/logos/sci.png',
  },
]
---

<Layout>
  <PageHead slot="head" title="Work" />
  <div class="mx-auto w-full max-w-[calc(var(--container-3xl)-2rem)]">
    <Breadcrumbs items={[{ label: 'Work', icon: 'lucide:briefcase' }]} />
  </div>

  <section
    class="mx-auto flex max-w-[calc(var(--container-3xl)-2rem)] flex-col gap-4"
  >
    <section class="mt-8">
      <div class="border-b pb-4">
        <p class="text-muted-foreground text-[11px] uppercase tracking-[0.28em]">
          Timeline
        </p>
        <div class="mt-3 flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
          <div>
            <h2 class="text-xl font-medium">Internships & startups</h2>
            <p class="text-muted-foreground mt-2 max-w-3xl text-sm leading-7">
              A cleaner chronological view of the teams, ventures, and environments
              that shaped how I build.
            </p>
          </div>
          <p class="text-muted-foreground text-xs">
            Hover over an entry to inspect it.
          </p>
        </div>
      </div>

      <div class="relative mt-6 pl-5 sm:pl-8">
        <div
          aria-hidden="true"
          class="bg-border absolute top-0 bottom-0 left-2 w-px sm:left-3"
        ></div>

        <ol class="space-y-3">
          {
            entries.map((entry) => (
              <li class="group/timeline relative">
                <div
                  aria-hidden="true"
                  class="absolute top-8 left-0 z-10 flex size-4 items-center justify-center rounded-full border border-primary/30 bg-background shadow-[0_0_0_4px_rgba(26,24,20,1)] transition-all duration-300 sm:left-[0.2rem] sm:group-hover/timeline:border-primary sm:group-hover/timeline:bg-primary/12"
                >
                  <div class="bg-primary/70 size-1.5 rounded-full transition-colors duration-300 sm:group-hover/timeline:bg-primary"></div>
                </div>

                <article class="ml-6 border bg-background transition-all duration-300 sm:ml-10 sm:hover:border-primary/30 sm:hover:bg-primary/[0.03]">
                  <div class="grid gap-0 lg:grid-cols-[9rem_minmax(0,1fr)]">
                    <div class="border-b px-4 py-4 lg:border-r lg:border-b-0 lg:px-5">
                      <p class="text-muted-foreground text-[10px] uppercase tracking-[0.24em]">
                        {entry.type}
                      </p>
                      <p class="mt-2 text-lg">{entry.period}</p>
                    </div>

                    <div class="p-4 lg:p-5">
                      <div class="flex flex-col gap-4">
                        <div class="flex items-start gap-4">
                          {
                            entry.logo ? (
                              <div class="border bg-muted/20 flex size-12 shrink-0 items-center justify-center overflow-hidden p-1 transition-all duration-300 sm:group-hover/timeline:border-primary/30 sm:group-hover/timeline:bg-primary/10">
                                <img
                                  src={entry.logo}
                                  alt={`${entry.organization} logo`}
                                  class="max-h-full max-w-full object-contain"
                                />
                              </div>
                            ) : (
                              <div class="border bg-muted/20 flex size-12 shrink-0 items-center justify-center text-sm font-semibold transition-all duration-300 sm:group-hover/timeline:border-primary/30 sm:group-hover/timeline:bg-primary/10 sm:group-hover/timeline:text-primary">
                                {entry.monogram}
                              </div>
                            )
                          }

                          <div class="min-w-0 flex-1">
                            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                              <div>
                                <h3 class="text-lg font-medium transition-colors duration-300 sm:group-hover/timeline:text-primary">
                                  {entry.title}
                                </h3>
                                <p class="text-foreground/78 mt-1 text-sm">
                                  {entry.organization}
                                </p>
                              </div>

                              <div class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
                                <span class="flex items-center gap-1.5">
                                  <Icon name="lucide:map-pin" class="size-3" />
                                  {entry.location}
                                </span>
                                <span class="flex items-center gap-1.5">
                                  <Icon name="lucide:calendar-range" class="size-3" />
                                  {entry.dateRange}
                                </span>
                              </div>
                            </div>

                            <p class="text-foreground/72 mt-4 text-sm leading-8 transition-colors duration-300 sm:group-hover/timeline:text-foreground/90">
                              {
                                entry.organization === 'The Collective' ? (
                                  <>
                                    Co-Founded The Collective, a Venture Studio
                                    that accelerates student startup founders
                                    growth and brings corporate deals to them.
                                    Checkout our website{' '}
                                    <a
                                      href="https://www.thecollectivefounders.com/"
                                      target="_blank"
                                      rel="noreferrer noopener"
                                      class="text-foreground underline decoration-muted-foreground underline-offset-[3px] transition-colors hover:text-primary hover:decoration-primary"
                                    >
                                      here
                                    </a>
                                    !
                                  </>
                                ) : (
                                  entry.summary
                                )
                              }
                            </p>

                            {
                              entry.highlights.length > 0 && (
                                <div class="mt-4 overflow-hidden transition-all duration-300 sm:max-h-0 sm:opacity-0 sm:group-hover/timeline:max-h-96 sm:group-hover/timeline:opacity-100">
                                  <div class="flex flex-wrap gap-2 border-t pt-4">
                                    {entry.highlights.map((highlight) => (
                                      <span class="border bg-background px-2.5 py-1 text-[11px] leading-5 text-muted-foreground transition-all duration-300 sm:group-hover/timeline:border-primary/25 sm:group-hover/timeline:bg-primary/10 sm:group-hover/timeline:text-primary">
                                        {highlight}
                                      </span>
                                    ))}
                                  </div>
                                </div>
                              )
                            }
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </section>
</Layout>
